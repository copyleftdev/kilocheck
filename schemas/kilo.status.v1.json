{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kilocheck.dev/schemas/kilo.status.v1.json",
  "title": "KiloCheck local dataset status",
  "type": "object",
  "required": ["schema", "installed", "home", "integrity", "snapshot"],
  "properties": {
    "schema": { "const": "kilo.status.v1" },
    "installed": { "type": "boolean" },
    "home": { "type": "string", "minLength": 1 },
    "integrity": { "enum": ["unavailable", "manifest-present", "verified", "invalid"] },
    "snapshot": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "required": ["id", "created_at", "manifest_schema"],
          "properties": {
            "id": { "type": "string", "minLength": 1 },
            "created_at": { "type": "string", "format": "date-time" },
            "manifest_schema": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": false
        }
      ]
    }
  },
  "additionalProperties": false
}
